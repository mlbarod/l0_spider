# 예시만 포함. 실제 값은 Git 밖의 process manager EnvironmentFile/Secret에 설정.
# 이 파일은 자동으로 로드되지 않음. docs/operations/sso.md 참조.
SSO_ENABLED=false
SSO_CLIENT_ID=
SSO_REDIRECT_URI=https://spider.example/auth/callback
SSO_AUTHORIZE_URL=https://idp.example/adfs/oauth2/authorize/
# 관리자에게 받은 완성된 로그아웃 URL(필요한 복귀 URI 쿼리 포함)
SSO_SIGNOUT_URL=
SSO_EXPECTED_ISSUER=
# 실제 token의 claim 키. USER ID/USER NAME/DEP NAME은 화면 라벨이며 키를 뜻하지 않음.
SSO_USER_ID_CLAIM=
SSO_DISPLAY_NAME_CLAIM=
SSO_DEPARTMENT_CLAIM=
# true: 검증 후 키/자료형만 로그로 확인, 로그인 세션은 생성하지 않음.
SSO_SAFE_CLAIM_TRACE=false
SSO_CERTIFICATE_PATH=/etc/l0_spider/idp-token-signing.cer
SSO_SESSION_SECRET=
# Node에서 관찰되는 Nginx의 정확한 IP. CIDR/true/* 금지.
SSO_TRUSTED_PROXY_IPS=127.0.0.1,::1
SSO_LOGIN_TRANSACTION_SECONDS=300
SSO_SESSION_IDLE_SECONDS=1800
SSO_SESSION_ABSOLUTE_SECONDS=28800
SSO_CLOCK_TOLERANCE_SECONDS=60
SSO_MAX_SESSIONS=10000
LIVE_RELOAD=0
BUILD_ON_START=0
