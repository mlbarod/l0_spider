# 이 파일을 저장소 루트의 .env.mail로 복사하고 실제 값을 입력합니다.
# .env.mail은 Git에서 제외되며 npm start 시 읽습니다. 변경 후 서버 재시작이 필요합니다.
# 실제 발송을 사용하려면 토큰과 System-ID를 입력하고 true로 변경합니다.
# PNG는 HTML 본문에 Base64로 삽입합니다. 사내 메일의 이미지 표시는 아직 미검증입니다.
KNOX_MAIL_ENABLED=false
# Bearer 접두사 없이 토큰 값만 입력합니다.
KNOX_MAIL_TOKEN=
# SESSION_ID가 아니라 API의 System-ID 헤더 값입니다.
KNOX_MAIL_SYSTEM_ID=
# Quality-Hub와 동일한 기본 제한 시간(밀리초).
KNOX_MAIL_TIMEOUT_MS=5000
# API 주소는 Quality-Hub와 동일하게 서버 코드에 고정합니다.
# https://openapi.samsung.net/mail/api/v2.0/mails/send
# userId와 발신자는 서버가 확인한 로그인 사용자를 사용합니다.
# 중복 요청 방지 기록: 기본 .local/chart-mail-requests.json (7일 보관).
# 단일 Node 프로세스용입니다. 배포 시 재시작 후에도 유지되는 경로를 사용합니다.
# CHART_MAIL_REQUESTS_PATH=/별도/보존/경로/chart-mail-requests.json
