# 이 파일을 저장소 루트의 .env.mail로 복사하고 실제 값을 입력합니다.
# .env.mail은 Git에서 제외되며 npm start 시 읽습니다. 변경 후 서버 재시작이 필요합니다.
# 실제 발송을 사용하려면 토큰과 System-ID를 입력하고 true로 변경합니다.
# PNG는 HTML 본문에 Base64로 삽입합니다. 사내 메일의 이미지 표시는 아직 미검증입니다.
KNOX_MAIL_ENABLED=false
# Bearer 접두사 없이 토큰 값만 입력합니다.
KNOX_MAIL_TOKEN=
# SESSION_ID가 아니라 API의 System-ID 헤더 값입니다.
KNOX_MAIL_SYSTEM_ID=
# Base64 차트 업로드와 API 응답을 기다리는 전체 제한 시간(밀리초).
# 기존 파일에 5000이 있으면 그 값이 우선하므로 아래 값으로 변경 후 재시작합니다.
KNOX_MAIL_TIMEOUT_MS=30000
# API 주소는 Quality-Hub와 동일하게 서버 코드에 고정합니다.
# https://openapi.samsung.net/mail/api/v2.0/mails/send
# userId와 발신자는 서버가 확인한 로그인 사용자를 사용합니다.
# 중복 요청 방지 기록: 기본 .local/chart-mail-requests.json (7일 보관).
# 단일 Node 프로세스용입니다. 배포 시 재시작 후에도 유지되는 경로를 사용합니다.
# CHART_MAIL_REQUESTS_PATH=/별도/보존/경로/chart-mail-requests.json

# Chart Mailing 게시판 + 발송 당시 PNG 원본 DB 보관.
# docs/features/chart-mail-board.sql의 테이블 4개를 준비한 뒤 true로 변경합니다.
# 기존 DB_INFO_PATH 접속 설정을 사용합니다. true일 때 DB 저장 실패 시 발송하지 않습니다.
# false이면 기존 메일 발송만 유지하며 게시판에 새 기록을 남기지 않습니다.
CHART_MAIL_BOARD_ENABLED=false

# Mailing Report 외부 발송기의 대시보드 조회 인증키 (Chart Mailing과 별개).
# 양쪽 서버에 동일한 무작위 키를 설정합니다. 영문/숫자/_/- 32~256자,
# 권장: 암호학적으로 안전하게 생성한 32바이트의 hex 값(64자).
# 빈 값 또는 형식 오류이면 전용 API는 503으로 비활성화됩니다.
# KNOX_MAIL_TOKEN, SSO_SESSION_SECRET과 다른 키를 사용합니다.
# GET /api/mailing-report/dashboard-data, Authorization: Bearer <키>
# SSO 운영에서는 기존 HTTPS 프록시 주소로 호출합니다. 설정 후 재시작 필요.
MAILING_REPORT_API_KEY=
